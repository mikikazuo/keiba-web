FB_PROJECT_ID="your-firebase-project-id"
# Paste service account private key here, use literal \n for newlines
FB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...your key...\n-----END PRIVATE KEY-----\n"
FB_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# Optional: BigQuery service account credentials (used by analytics API)
GC_PROJECT_ID="your-gcp-project-id"
GC_CLIENT_EMAIL="your-bigquery-service-account@your-project.iam.gserviceaccount.com"
GC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...your key...\n-----END PRIVATE KEY-----\n"

# Other secrets
CLOUD_FLARE_TURNSTILE_KEY="your-turnstile-key"

# NOTE: Do NOT commit your real private keys. Copy this file to `.env.local`
# and populate values locally. Ensure `.gitignore` prevents committing `.env.local`.

# Biguqueryのための認証情報ファイルのパスを指定
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/boost/path/to/your-service-account-key.json